# Copy to .env.local and fill in from Supabase → Settings → API Keys.
# Leave both blank to run the app in local-only demo mode (no sync).
#
# The PUBLISHABLE key (sb_publishable_...) goes here. It is public by
# design (Vite bakes it into the bundle); the database only lets signed-in,
# allowlisted family members in. See MIGRATION_NOTES.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Header text — keeps personal detail out of the repo.
VITE_OWNER_NAME=
VITE_OWNER_SUBTITLE=
VITE_OWNER_LOCATION=

# Optional passphrase screen — local-only mode only (ignored with Supabase).
VITE_APP_PASSPHRASE=

# ── Server-side only (Vercel env, never VITE_-prefixed, never committed) ──
# Required by /api/mcp (the Claude.ai connector):
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# DASHBOARD_MCP_KEY=<at least 32 random characters: openssl rand -hex 32>
# MCP_REDIRECT_HOSTS=claude.ai,claude.com
