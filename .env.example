# Copy to .env.local and fill in from Supabase → Settings → API Keys.
# Use the PUBLISHABLE key (sb_publishable_...), not a secret key.
# Leave both blank to run the app in local-only mode (localStorage, no sync).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional passphrase gate. Leave blank for no gate.
VITE_APP_PASSPHRASE=

# Header text — keeps personal detail out of the repo.
VITE_OWNER_NAME=
VITE_OWNER_SUBTITLE=
VITE_OWNER_LOCATION=
